# Pixel preview gateway for static and full-stack projects. DNS: A record *.preview -> Caddy server IP
PREVIEW_BASE_DOMAIN=preview.pixelgenius.ir
PREVIEW_URL_TEMPLATE=https://{slug}.preview.pixelgenius.ir
PUBLIC_MCP_URL=https://chat.pixelgenius.ir/mcp
SITE_TTL_DAYS=5
SITE_GRACE_DAYS=7
