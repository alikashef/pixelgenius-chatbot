{
	email {$CADDY_EMAIL}
	on_demand_tls {
		ask http://backend:8000/api/preview/allow
	}
}

(app_routes) {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle /uploads/* {
		reverse_proxy backend:8000
	}

	handle /mcp {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

{$APP_DOMAIN} {
	import app_routes
}

*.{$PREVIEW_DOMAIN:preview.localhost} {
	tls {
		on_demand
	}
	encode gzip zstd
	reverse_proxy backend:8000
}

http://:80 {
	import app_routes
}
