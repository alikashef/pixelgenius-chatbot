{
	email {$CADDY_EMAIL}
	on_demand_tls {
		ask http://backend:8000/api/preview/allow
	}
}

(app_routes) {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle /uploads/* {
		reverse_proxy backend:8000
	}

	handle /mcp {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

{$APP_DOMAIN} {
	import app_routes
}

(preview_routes) {
	route {
		request_header -X-Preview-Upstream
		request_header -X-Preview-Kind
		forward_auth backend:8000 {
			uri /api/preview/route?domain={host}
			header_up -Upgrade
			header_up -Connection
			header_up -Sec-WebSocket-*
			header_up Host backend:8000
			copy_headers X-Preview-Upstream X-Preview-Kind
		}
		@dynamic header X-Preview-Kind dynamic
		handle @dynamic {
			reverse_proxy {http.request.header.X-Preview-Upstream}:443 {
				header_up Host {http.request.header.X-Preview-Upstream}
				header_up X-Forwarded-Host {hostport}
				header_up X-Forwarded-Proto https
				header_up -X-Preview-Upstream
				header_up -X-Preview-Kind
				header_down Location `(?i)^https?://(?:[a-z0-9-]+\.)+liara\.(?:run|space)(?::[0-9]+)?(.*)$` "https://{hostport}$1"
				header_down Set-Cookie `(?i);\s*Domain=\.?(?:[a-z0-9-]+\.)*liara\.(?:run|space)(;|$)` "$1"
				flush_interval -1
				transport http {
					tls
					tls_server_name {http.request.header.X-Preview-Upstream}
				}
			}
		}
		handle {
			reverse_proxy backend:8000
		}
	}
}

# Internal entry point when an existing reverse proxy terminates public TLS.
http://:8080 {
	import preview_routes
}

*.{$PREVIEW_DOMAIN:preview.localhost} {
	tls {
		on_demand
	}
	encode gzip zstd
	import preview_routes
}

http://*.{$PREVIEW_DOMAIN:preview.localhost} {
	redir https://{host}{uri} permanent
}

http://:80 {
	import app_routes
}
